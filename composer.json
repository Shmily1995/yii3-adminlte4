{
    "name": "interview-treasure/yii3-adminlte4",
    "description": "AdminLTE 4 的 Yii3 集成包：资源包、可复用布局、数据驱动侧边栏菜单与基础 Widget。零 jQuery、零前端构建。",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "yii3",
        "adminlte",
        "adminlte4",
        "bootstrap5",
        "asset-bundle",
        "admin-panel",
        "view"
    ],
    "require": {
        "php": "^8.1",
        "psr/container": "^1.1 || ^2.0",
        "yiisoft/aliases": "^2.0 || ^3.0",
        "yiisoft/assets": "^5.0",
        "yiisoft/view": "^12.0",
        "yiisoft/widget": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "yiisoft/yii-view-renderer": "可选：安装后可启用 AdminLte4\\Injection\\AdminLteInjection 视图注入（替代手动传参）"
    },
    "autoload": {
        "psr-4": {
            "AdminLte4\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdminLte4\\Tests\\": "tests/"
        }
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di-web": "di-web.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirrors.cloud.tencent.com/repository/composer/"
        },
        {
            "packagist.org": false
        }
    ]
}
